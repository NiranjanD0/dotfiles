# Env
source = ~/dotfiles/.config/hypr/conf/env.conf

# Monitor
source = ~/dotfiles/.config/hypr/conf/monitors.conf

# Programs
source = ~/dotfiles/.config/hypr/conf/programs.conf

# AutoStart
source = ~/dotfiles/.config/hypr/conf/autostart.conf

# Look and feel
source = ~/dotfiles/.config/hypr/conf/animations.conf
source = ~/dotfiles/.config/hypr/conf/decorations.conf

# KeyBindings
source = ~/dotfiles/.config/hypr/conf/keybindings.conf

# WindowRules
source = ~/dotfiles/.config/hypr/conf/windowrules.conf

# Plugins
source = ~/dotfiles/.config/hypr/conf/plugins.conf

# Input settings
input {
    kb_layout = us
    follow_mouse = 1
    touchpad {
        natural_scroll = yes
    }
}

# General settings
general {
    gaps_in = 2
    gaps_out = 0
    border_size = 1
    col.active_border = rgb(525252)
    col.inactive_border = rgb(454545)
    layout = dwindle
}


monitor=HDMI-A-5,1920x1080@143.85,0x352,1.40
monitor=eDP-1,1920x1080@144.00,1408x32,1.00